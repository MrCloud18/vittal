DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

JWT_SECRET=replace_with_a_secure_random_string
JWT_REFRESH_SECRET=replace_with_another_secure_random_string

PORT=3000
NODE_ENV=development

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
MAINTENANCE_MODE=false
BCRYPT_ROUNDS=12

SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

EXPO_PUSH_ACCESS_TOKEN=
INGEST_API_KEY=
PUSH_ON_INGEST=true
DISABLE_ALL_RATE_LIMITS=false
GENERAL_RATE_LIMIT_WINDOW_MS=900000
GENERAL_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5
INGEST_RATE_LIMIT_WINDOW_MS=60000
INGEST_RATE_LIMIT_MAX=120
DEBUG_LOG_RATE_LIMIT_WINDOW_MS=60000
DEBUG_LOG_RATE_LIMIT_MAX=30
